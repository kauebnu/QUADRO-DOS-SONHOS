# =====================================================================
# Supabase do WE DREAM — modelo.
#
# NÃO preencha à mão. Rode:
#   node scripts/gerar-env.mjs --app quadrodossonhos.antonellaroweder.com.br
#
# Ele gera este arquivo com senhas fortes e as chaves de API já assinadas.
# =====================================================================

# ------------------------------------------------------------- segredos
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# --------------------------------------------------------------- banco
POSTGRES_DB=postgres
JWT_EXPIRY=3600

# ------------------------------------------------------------ endereços
# Domínio do app
SITE_URL=https://quadrodossonhos.antonellaroweder.com.br
# Domínio da API (subdomínio próprio, servido pelo nginx)
API_EXTERNAL_URL=https://api.quadrodossonhos.antonellaroweder.com.br
SUPABASE_PUBLIC_URL=https://api.quadrodossonhos.antonellaroweder.com.br
ADDITIONAL_REDIRECT_URLS=https://quadrodossonhos.antonellaroweder.com.br/**

# ------------------------------------------------------------- portas
# Todas presas em 127.0.0.1. Confira antes que nenhuma esteja ocupada:
#   OCUPADAS nesta VPS: 22 80 443 3000 3100 5432 5433 6379 8080 9001 9998 9999
POSTGRES_PORT=5434
AUTH_PORT=4001
REST_PORT=4002
STORAGE_PORT=4003
STUDIO_PORT=4004

# --------------------------------------------------------------- fotos
STORAGE_TENANT_ID=wedream
GLOBAL_S3_BUCKET=dream-images
REGION=sa-east-1
FILE_SIZE_LIMIT=52428800

# --------------------------------------------------------------- REST
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# --------------------------------------------------------------- login
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# true = a conta já entra sem confirmar o e-mail.
# É o único jeito de funcionar sem SMTP — mas assim a recuperação de senha
# não funciona. Configure o SMTP abaixo e mude para false.
ENABLE_EMAIL_AUTOCONFIRM=true

# --------------------------------------------------------------- e-mail
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=WE DREAM

# --------------------------------------------------------------- painel
STUDIO_DEFAULT_ORGANIZATION=Antonella Roweder
STUDIO_DEFAULT_PROJECT=WE DREAM

LOG_LEVEL=info
