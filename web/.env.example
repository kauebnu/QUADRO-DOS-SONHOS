# Desenvolvimento local do app (npm run dev).
# Copie para .env.local e preencha.
#
# Em produção NÃO usamos estas variáveis: o container escreve /config.js
# a partir do .env da raiz (veja deploy/docker-entrypoint.sh).
#
# Deixando tudo em branco, o app sobe em MODO DEMONSTRAÇÃO — útil para
# mexer no visual sem depender de backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=
