# =====================================================================
# WE DREAM — variáveis de ambiente
# Copie para .env  (cp .env.example .env)  e preencha.
# O .env NUNCA vai para o Git.
# =====================================================================

# ------------------------------------------------------------ Supabase
# Painel do Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública ("anon" / publishable). Pode aparecer no navegador — o RLS protege.
SUPABASE_ANON_KEY=

# Chave secreta ("service_role"). Ignora TODAS as regras de segurança.
# Só o servidor de notificações usa. NUNCA coloque no app nem em repositório.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------- notificações (VAPID)
# Gere uma vez com:  cd push-server && npm install && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@antonellaroweder.com.br

# ------------------------------------------------------------ operação
# Portas locais na VPS (o proxy reverso do host aponta para elas).
# Troque se já houver outro projeto usando estas portas.
WEB_PORT=8080
PUSH_PORT=8081

# De quanto em quanto tempo o servidor confere quem está no horário escolhido
TICK_MINUTES=15

# true = não envia nada, só registra no log o que seria enviado (útil no 1º dia)
DRY_RUN=false

# Fuso padrão do container
TZ=America/Sao_Paulo

# Token para disparar uma rodada manualmente:
#   curl -X POST -H "x-admin-token: SEU_TOKEN" http://127.0.0.1:8081/run
# Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# Opcional: URL pública do servidor de push, se um dia for exposta
PUSH_API_URL=
